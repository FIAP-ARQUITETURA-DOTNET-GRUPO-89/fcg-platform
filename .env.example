# ---------------------------------------------------------------------------
# Credenciais da FCG Platform
#
# Local (Docker Compose e Kubernetes):  cp .env.example .env
# AWS (Parameter Store):                cp .env.example .env.aws
#
# Preencha com valores próprios. .env e .env.aws são ignorados pelo Git.
# Use só letras e números (ex.: openssl rand -hex 24): os valores entram em
# connection strings e URLs.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=fcg
POSTGRES_PASSWORD=troque-me

# RabbitMQ
RABBITMQ_USER=fcg
RABBITMQ_PASSWORD=troque-me
RABBITMQ_ERLANG_COOKIE=troque-me

# Chave de assinatura do JWT: a MESMA para users, catalog, payments e Kong.
# Mínimo 32 caracteres (openssl rand -hex 32).
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres

# pgAdmin
PGADMIN_EMAIL=admin@fcg.com
PGADMIN_PASSWORD=troque-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-me

# Opcionais (os padrões atendem o cluster local).
# Na AWS com Amazon OpenSearch, informe o endpoint e o usuário master do domínio.
# MONGO_CONNECTION=mongodb://mongodb:27017
# OPENSEARCH_URL=http://fcg-opensearch:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=

# Somente para "scripts/secrets.sh aws"
# AWS_REGION=us-east-1
# PARAMETER_PREFIX=/fcg-platform
