          "name": "Auth",
          "item": [
            {
              "name": "Auth Maria | ADM",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// 1. Converte a resposta para JSON\r",
                      "const responseData = pm.response.json();\r",
                      "\r",
                      "// 2. Extrai o token\r",
                      "const tokenValue = responseData.token;\r",
                      "\r",
                      "// 3. Salva especificamente nas variáveis da COLEÇÃO\r",
                      "pm.collectionVariables.set(\"token\", tokenValue);\r",
                      "\r",
                      "console.log(\"Token salvo na Coleção: \" + pm.collectionVariables.get(\"token\"));"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"email\": \"maria.silva@email.com\",\r\n  \"password\": \"Abc!1234\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{Base-URL-User-API}}/auth/login",
                  "host": [
                    "{{Base-URL-User-API}}"
                  ],
                  "path": [
