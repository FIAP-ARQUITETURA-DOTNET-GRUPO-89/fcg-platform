    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Memória em uso (working set)",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom"}},
      "targets": [
