    {
      "type": "timeseries",
      "id": 10,
      "title": "Coletas do GC (por geração, taxa)",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
